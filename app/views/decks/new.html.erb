<div class="container">
  <h1>Commander Universes Between</h1>
  <p class="muted">Generate a themed reinterpretation of your commander deck.</p>

  <% if flash[:alert].present? %>
    <p class="error"><%= flash[:alert] %></p>
  <% end %>

  <div class="card">
    <%= form_with model: @deck, url: decks_path do |f| %>
      <div class="grid two">
        <div>
          <%= f.label :commander_name %>
          <%= f.text_field :commander_name, required: true %>
        </div>
        <div>
          <%= f.label :title %>
          <%= f.text_field :title %>
        </div>
      </div>

      <div style="margin-top: 1rem;">
        <%= f.label :theme_description, "Theme / World Description" %>
        <%= f.text_area :theme_description, required: true, style: "min-height: 8rem;" %>
      </div>

      <div style="margin-top: 1rem;">
        <%= f.label :input_text, "Deck List (quantity + card name per line)" %>
        <%= f.text_area :input_text, required: true %>
      </div>

      <div style="margin-top: 1rem;">
        <%= f.submit "Generate themed deck" %>
      </div>
    <% end %>
  </div>
</div>
