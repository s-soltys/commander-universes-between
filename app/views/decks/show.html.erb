<div class="container">
  <h1><%= @deck.title.presence || "Themed Deck" %></h1>
  <p>
    <strong>Commander:</strong> <%= @deck.commander_name %>
    <span class="badge <%= @deck.status if @deck.status != 'complete' %>"><%= @deck.status %></span>
  </p>
  <p class="muted"><strong>Theme:</strong> <%= @deck.theme_description %></p>

  <p class="muted">Share URL: <%= deck_url(@deck.share_slug) %></p>

  <% if @deck.deck_errors.any? %>
    <div class="card" style="margin-bottom: 1rem;">
      <h2>Input issues</h2>
      <ul>
        <% @deck.deck_errors.order(:line_number).each do |error| %>
          <li>
            <strong>Line <%= error.line_number %></strong>: <%= error.message %>
            <span class="muted">(<%= error.line_text %>)</span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid">
    <% @deck.deck_cards.order(:original_name).each do |card| %>
      <article class="card">
        <h3><%= card.themed_name %> <span class="muted">x<%= card.quantity %></span></h3>
        <p><strong>Original:</strong> <%= card.original_name %></p>
        <p><strong>Type:</strong> <%= card.card_type %></p>
        <p><%= card.art_description %></p>
      </article>
    <% end %>
  </div>

  <p style="margin-top: 1rem;">
    <%= link_to "Create another deck", root_path, class: "button" %>
  </p>
</div>
