    type: string\n    DeckResponse:\n      type: object\n      properties:\n        id:\n          type: string\n        share_url:\n          type: string\n        status:\n          type: string\n          enum: [complete, partial, failed]\n        commander_name:\n          type: string\n        theme_description:\n          type: string\n        cards:\n          type: array\n          items:\n            $ref: '#/components/schemas/DeckCard'\n        errors:\n          type: array\n          items:\n            $ref: '#/components/schemas/DeckError'\n    DeckCard:\n      type: object\n      properties:\n        original_name:\n          type: string\n        quantity:\n          type: integer\n        card_type:\n          type: string\n        themed_name:\n          type: string\n        art_description:\n          type: string\n        image_url:\n          type: string\n          nullable: true\n    DeckError:\n      type: object\n      properties:\n        line_number:\n          type: integer\n        line_text:\n          type: string\n        error_code:\n          type: string\n        message:\n          type: string\n    ErrorResponse:\n      type: object\n      properties:\n        error:\n          type: string\n        details:\n          type: string\nEOF","yield_time_ms":1000,"max_output_tokens":2000,"sandbox_permissions":"require_escalated","justification":"Do you want to write the OpenAPI contract file?","prefix_rule":["cat"]} thread_id=019c3cc7-c2c6-7fc0-bfc7-88f4a89828de
